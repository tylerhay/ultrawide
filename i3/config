# screenshot
bindsym Print exec flameshot gui
#bindsym Print exec /home/tyler/.oh-my-zsh/custom/scripts/shot.sh
#clipboard
bindsym $mod+shift+v exec --no-startup-id ~/.config/rofi/clipboard.sh

#GAPS
gaps inner 8 
gaps outer 2
#disables borders
for_window [class="^.*"] border pixel 3 
smart_gaps on
hide_edge_borders smart_no_gaps
#smart_borders no_gaps
#hide_edge_borders smart_no_gaps

# always float steam
#for_window [class="steam"] floating enable
for_window [class="Nitrogen"] floating enable
for_window [class="qBittorrent"] floating enable
for_window [class="Transmission"] floating enable
for_window [class="CalcursePopup"] floating enable
for_window [class="CalcursePopup"] border none
for_window [class="CalcursePopup"] move position 900 20
for_window [class="steamwebhelper"] floating enable
for_window [class="Steam Settings"] floating enable
assign [class="steam"] $ws9 
assign [instance="^steam_app_.*$"] $ws9
assign [instance="^steam_proton_.*$"] $ws9
assign [class="bottles"] $ws9
assign [class="Wine"] $ws9
assign [instance="^wine.*"] $ws9
assign [class="vesktop"] $ws10

#exec_always --no-startup-id xrandr --output DP-0 --primary --mode 1920x1080 --pos 0x728 --rotate normal --rate 144.00 --output DP-2 --mode 1920x1080 --pos 1920x0 --rotate left --rate 144.00
